# Required to query Decibel data.
DECIBEL_API_KEY=
NETWORK=testnet
PRODUCT=perp
MARKET=BTC/USD
SUBACCOUNT_ADDRESS=

# Choose exactly one price range form.
GRID_RANGE_PERCENT=10
# GRID_LOWER_PRICE=65000
# GRID_UPPER_PRICE=80000
# GRID_STEP_PERCENT=0.5

# Recommended allocation form.
GRID_TOTAL_COUNT=40
GRID_TOTAL_BUDGET=1000
# Alternative fixed quantity form; do not combine with GRID_TOTAL_BUDGET.
# GRID_ORDER_SIZE=0.001

GRID_REFRESH_SECONDS=3
GRID_MAKER_FEE_RATE=0.0001
PRICE_SOURCE=prices
