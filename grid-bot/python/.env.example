# Required to run (not required for --preview if SUBACCOUNT_ADDRESS and GRID_MAKER_FEE_RATE are set).
# Aptos Ed25519 private key, hexadecimal; 0x prefix is optional.
PRIVATE_KEY=0x...

# Required: Decibel dashboard API key for Decibel REST/WebSocket market and account APIs.
DECIBEL_API_KEY=

# Optional: Aptos fullnode RPC API key, used when submitting signed transactions.
# NODE_API_KEY is also accepted as a legacy fallback.
APTOS_NODE_API_KEY=

# Optional for live trading. It is derived from PRIVATE_KEY if omitted.
# For --preview without PRIVATE_KEY, set this to load your actual maker fee tier.
SUBACCOUNT_ADDRESS=

NETWORK=testnet
MARKET=BTC/USD

# ---- Grid range: choose ONE mode only -----------------------------------------
# A) Fixed bounds. The live midpoint must fall inside this interval.
# GRID_LOWER_PRICE=65000
# GRID_UPPER_PRICE=80000
#
# B) Symmetric percentage range around the live midpoint. 10 means midpoint ±10%.
GRID_RANGE_PERCENT=10
#
# C) Compounded percentage distance between adjacent levels. 0.5 means 0.5%/level.
# GRID_STEP_PERCENT=0.5

# ---- Grid count: prefer total combined orders ---------------------------------
# Decibel allows at most 40 bids + 40 asks. 40 means about 20 bids + 20 asks.
GRID_TOTAL_COUNT=40
# Legacy alternative: this means 40 bids + 40 asks; do not set with GRID_TOTAL_COUNT.
# GRID_LEVELS_PER_SIDE=40

# ---- Capital allocation: choose ONE mode only ---------------------------------
# Recommended: total quote/USDC budget. The bot derives uniform, lot-aligned sizes.
# Spot splits it 50/50 between bid quote reserve and ask base inventory at mid price.
# Perp treats it as a conservative margin budget using PREVIEW_LEVERAGE.
GRID_TOTAL_BUDGET=1000
# Legacy alternative: fixed base quantity per order.
# GRID_ORDER_SIZE=0.001

GRID_REFRESH_SECONDS=20

# Perp only: neutral = two-sided, long = bids only, short = asks only.
PERP_GRID_MODE=neutral

# Perp only: bot cancels its grid when current plus worst-case same-side grid fills exceeds this.
# GRID_MAX_POSITION=0.05

# Optional. Decimal rate, not bps: 0.0001 is 0.01%.
# If omitted, --preview fetches your effective maker fee from the SDK user-fees API.
# GRID_MAKER_FEE_RATE=0.0001

# Perp preview only: used for a conservative margin estimate; it never changes account leverage.
PREVIEW_LEVERAGE=1

# Mid-price source: 'depth' (live order book, default) or 'prices' (/prices mid_px).
# Only switch to 'prices' if /depth is unavailable AND you have read the README caveats:
# /prices is not the live book, so post-only orders may be priced against stale data.
PRICE_SOURCE=depth

# Always begin with dry run. --preview never submits/cancels transactions.
DRY_RUN=true
LOG_LEVEL=INFO
